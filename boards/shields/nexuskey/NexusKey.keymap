#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define SYSTEM 1
#define BLUETOOTH 2

&soft_off {
    hold-time-ms = <3000>; // Only turn off if the key is held for 2 seconds or longer.
};

/ {
    keymap
    {
        compatible = "zmk,keymap";

        default_layer {
            bindings = 
            <
                &kp Q   &kp W   &kp F   &kp P   &kp B
                &kp A   &kp R   &kp S   &kp T   &kp G   &mo BLUETOOTH
                &kp Z   &kp X   &kp C   &kp D   &kp V   &mo SYSTEM
            >;
        };

        system_layer {
            bindings = 
            <
                &soft_off       &trans   &trans   &trans   &sys_reset
                &trans          &trans   &trans   &trans   &trans       &trans
                &bootloader     &trans   &trans   &trans   &trans       &trans
            >;
        };
    };
};
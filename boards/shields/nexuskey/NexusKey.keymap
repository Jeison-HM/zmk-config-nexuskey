#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&soft_off {
    hold-time-ms = <2000>; // Only turn off if the key is held for 2 seconds or longer.
};

/ {
    keymap
    {
        compatible = "zmk,keymap";

        default_layer {
            bindings = 
            <
                &kp A    &soft_off
                &kp C    &bootloader
            >;
        };
    };
};
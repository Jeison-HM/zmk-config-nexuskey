#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen
    {
        zmk,kscan = &default_kscan;
        zmk,matrix-transform = &default_transform;
    };

    default_kscan: kscan
    {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        label = "default_kscan";
        diode-direction = "col2row";

        row-gpios 
            = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   //P0.24
            , <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    //P1.06
            ;

        col-gpios
            = <&gpio1 15 GPIO_ACTIVE_HIGH>  //P1.15
            , <&gpio1 0 GPIO_ACTIVE_HIGH>   //P1.00
            ;
    };

    default_transform: matrix_transform
    {
        compatible = "zmk,matrix-transform";
        rows = <2>;
        columns = <2>;

        map =
        <
            RC(0,0) RC(0,1)
            RC(1,0) RC(1,1)
        >;
    };
};

/ {
    keys {
        compatible = "gpio-keys";
        soft_off_key: soft_off_key {
            gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; //P0.02 Soft Off
        };
    };
};
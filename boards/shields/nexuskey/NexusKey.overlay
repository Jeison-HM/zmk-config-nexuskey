#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen
    {
        zmk,kscan = &default_kscan;
        zmk,kscan = &side_band_behavior_triggers;
        zmk,matrix-transform = &default_transform;
    };

    default_kscan: kscan
    {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        label = "default_kscan";
        diode-direction = "col2row";

        row-gpios 
            = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   //P0.24
            , <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    //P1.06
            , <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    //P0.02 Soft Off
            ;

        col-gpios
            = <&gpio1 15 GPIO_ACTIVE_HIGH>  //P1.15
            , <&gpio1 0 GPIO_ACTIVE_HIGH>   //P1.00
            ;
    };

    default_transform: matrix_transform
    {
        compatible = "zmk,matrix-transform";
        rows = <2>;
        columns = <2>;

        map =
        <
            RC(0,0) RC(0,1)
            RC(1,0) RC(1,1)
        >;
    };

    side_band_behavior_triggers: side_band_behavior_triggers
    {
        compatible = "zmk,kscan-sideband-behaviors";
        wakeup-source;
        kscan = <&kscan>;
        soft_off {
            column = <0>;
            row = <3>;
            bindings = <&hw_soft_off>;
        };
    };
};

/ {
    wakeup_source: wakeup_source {
        compatible = "zmk,gpio-key-wakeup-trigger";

        trigger = <&on_off_key>;
        wakeup-source;
    };
};

/ {
    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&wakeup_source>;
    };
};
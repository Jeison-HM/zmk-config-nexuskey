#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define NUMERIC 1
#define NAVIGATION 2
#define SYSTEM 3

&soft_off {
    hold-time-ms = <3000>;  // Wait 3s
};

/ {
    keymap
    {
        compatible = "zmk,keymap";

        default_layer {
            bindings = 
            <
                                &kp J   &kp L   &kp U       &kp Y       &kp SEMICOLON
                &mo NUMERIC     &kp M   &kp N   &kp E       &kp L       &kp O
                &mo SYSTEM      &kp K   &kp H   &kp COMMA   &kp PERIOD  &kp SLASH
            >;
        };

        // numeric_layer {

        // };

        system_layer {
            bindings = 
            <
                          &sys_reset      &none         &none         &none              &soft_off
                &none     &bt BT_SEL 2    &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR_ALL     &none
                &none     &none           &none         &none         &none              &bootloader
            >;
        };
    };
};
#include <physical_layouts.dtsi>

// Physical Layout

/ {
    nexuskey_layout: nexuskey_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";

        keys  //                 w     h       x       y     rot      rx      ry
        = <&key_physical_attrs 100   100   60.10   48.70   1500   110.10   98.70>
        , <&key_physical_attrs 100   100  222.00   14.10   2000   272.00   64.10>
        , <&key_physical_attrs 100   100  417.40   34.00   3000   467.40   84.00>
        , <&key_physical_attrs 100   100  551.40  189.90 (-4500)  601.40  239.90>

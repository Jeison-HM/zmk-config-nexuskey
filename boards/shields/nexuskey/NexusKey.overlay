#include <dt-bindings/zmk/matrix_transform.h>

// Matrix Scan

/ {
    chosen
    {
        zmk,kscan = &default_kscan;
        zmk,matrix-transform = &default_transform;
    };

    default_kscan: kscan
    {
        compatible = "zmk,kscan-gpio-matrix";
        label = "default_kscan";
        diode-direction = "col2row";

        row-gpios 
            = <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P1.02
            , <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    // P0.02
            , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    // P0.28
            ;

        col-gpios
            = <&gpio1 0 GPIO_ACTIVE_HIGH>  // P1.00
            , <&gpio0 22 GPIO_ACTIVE_HIGH>   // P0.22
            , <&gpio1 3 GPIO_ACTIVE_HIGH>   // P1.03
            , <&gpio0 31 GPIO_ACTIVE_HIGH>   // P0.31
            , <&gpio0 30 GPIO_ACTIVE_HIGH>   // P0.30
            , <&gpio1 13 GPIO_ACTIVE_HIGH>   // P1.13
            ;
    };

    default_transform: matrix_transform
    {
        compatible = "zmk,matrix-transform";
        rows = <3>;
        columns = <6>;

        map =
        <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)
        >;
    };
};

// Soff Off Behavior

/ {
// Device that activates after turning off keyboard.

    keys {
            compatible = "gpio-keys";
            soft_off_key: soft_off_key {
                gpios = <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // P0.07 Soft Off
            };
        };

// Attach the keys device to wake up sources so it can turn on the keyboard.

    wakeup_source: wakeup_source {
        compatible = "zmk,gpio-key-wakeup-trigger";
        extra-gpios = <&gpio1 0 (GPIO_ACTIVE_HIGH)>, <&gpio0 30 (GPIO_ACTIVE_HIGH)>; // Enable columns pins for AND gate.
        trigger = <&soft_off_key>;
        wakeup-source;
    };

// Attach the wake up sources to the Soft Off.

    soft_off_wakers {
            compatible = "zmk,soft-off-wakeup-sources";
            wakeup-sources = <&wakeup_source>;
    };

// Init Soft Off behavior when keyboard's off.

    behaviors {
            hw_soft_off: hw_soft_off {
                    compatible = "zmk,behavior-soft-off";
                    #binding-cells = <0>;
                    hold-time-ms = <3000>; // Only turn on if the key is held for 2 seconds or longer.
            };
    };
};
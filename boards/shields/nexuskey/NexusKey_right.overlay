#include "NexusKey.dtsi"

// The keyboard's switch matrix is read from left to right, top to bottom.
&default_transform
{
    col-offset = <6>;
};

&default_kscan
{
    row-gpios
        = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    // P0.09
        , <&gpio1 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    // P1.03
        , <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    // P1.00
        ;

    col-gpios
        = <&gpio1 11 GPIO_ACTIVE_HIGH>  // P1.11
        , <&gpio0 22 GPIO_ACTIVE_HIGH>  // P0.22
        , <&gpio0 28 GPIO_ACTIVE_HIGH>  // P0.28
        , <&gpio1 4 GPIO_ACTIVE_HIGH>   // P1.04
        , <&gpio1 6 GPIO_ACTIVE_HIGH>   // P1.06
        , <&gpio0 10 GPIO_ACTIVE_HIGH>  // P0.10
        ;
};

// Soff Off Behavior

/ {
    // Device that activates after turning off keyboard.

    keys {
        compatible = "gpio-keys";
        soft_off_key: soft_off_key {
            gpios = <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // P0.07 Soft Off
        };
    };

    // Attach the keys device to wake up sources so it can turn on the keyboard.

    wakeup_source: wakeup_source {
        compatible = "zmk,gpio-key-wakeup-trigger";
        trigger = <&soft_off_key>;
        extra-gpios
        = <&gpio1 11 GPIO_ACTIVE_HIGH>
        , <&gpio1 6 GPIO_ACTIVE_HIGH>
        ;
        wakeup-source;
    };

    // Attach the wake up sources to the Soft Off.

    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&wakeup_source>;
    };

    // Init Soft Off behavior when keyboard's off.

    behaviors {
        hw_soft_off: hw_soft_off {
                compatible = "zmk,behavior-soft-off";
                #binding-cells = <0>;
                hold-time-ms = <3000>;  // Wait 3s
        };
    };
};

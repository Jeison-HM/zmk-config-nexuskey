#include "NexusKey.dtsi"

// The keyboard's switch matrix is read from left to right, top to bottom.
&default_transform
{
    row-offset = <3>;
    col-offset = <6>;
};

&default_kscan
{
    row-gpios
        = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    // P0.09
        , <&gpio1 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    // P1.03
        , <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    // P1.00
        ;

    col-gpios
        = <&gpio0 10 GPIO_ACTIVE_HIGH>  // P0.10
        , <&gpio1 6 GPIO_ACTIVE_HIGH>   // P1.06
        , <&gpio1 4 GPIO_ACTIVE_HIGH>   // P1.04
        , <&gpio0 28 GPIO_ACTIVE_HIGH>  // P0.28
        , <&gpio0 22 GPIO_ACTIVE_HIGH>  // P0.22
        , <&gpio1 11 GPIO_ACTIVE_HIGH>  // P1.11
        ;
};

&wakeup_source
{
    extra-gpios
        = <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>
        , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>
        ;
};

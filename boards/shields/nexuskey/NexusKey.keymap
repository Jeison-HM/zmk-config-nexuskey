#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "mymacros.h"

&soft_off {
    hold-time-ms = <HOLD_TIME>;
};

/ {
    keymap
    {
        compatible = "zmk,keymap";

        default_layer {
            bindings = 
            <
                &kp Q   &kp W   &kp F   &kp P   &kp B                                   &kp J   &kp L   &kp U       &kp Y       &kp SEMICOLON
                &kp A   &kp R   &kp S   &kp T   &kp G   &mo NUMERIC     &mo NUMERIC     &kp M   &kp N   &kp E       &kp L       &kp O
                &kp Z   &kp X   &kp C   &kp D   &kp V   &mo SYSTEM      &mo SYSTEM      &kp K   &kp H   &kp COMMA   &kp PERIOD  &kp SLASH
            >;
        };

        // numeric_layer {

        // };

        system_layer {
            bindings = 
            <
                &soft_off   &trans  &trans  &trans  &sys_reset                          &sys_reset  &trans  &trans  &trans  &soft_off
                &soft_off      &trans  &trans  &trans  &trans       &trans     &trans      &trans      &trans  &trans  &trans  &trans
                &bootloader &trans  &trans  &trans  &trans       &trans     &trans      &trans      &trans  &trans  &trans  &bootloader
            >;
        };
    };
};
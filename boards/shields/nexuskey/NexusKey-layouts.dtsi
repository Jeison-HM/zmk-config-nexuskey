        , <&key_physical_attrs 100   100 1081.90  189.90   4500  1131.90  239.90>
        , <&key_physical_attrs 100   100 1215.90   34.00 (-3000) 1265.90   84.00>
        , <&key_physical_attrs 100   100 1411.30   14.10 (-2000) 1461.30   64.10>
        , <&key_physical_attrs 100   100 1573.20   48.70 (-1500) 1623.20   98.70>
        // Row 0
        , <&key_physical_attrs 100   100   35.70  145.30   1500    85.70  195.30>
        , <&key_physical_attrs 100   100  189.70  108.10   2000   239.70  158.10>
        , <&key_physical_attrs 100   100  370.20  120.60   3000   420.20  170.60>
        , <&key_physical_attrs 100   100  484.60  260.60 (-4500)  534.60  310.60>
        , <&key_physical_attrs 100   100  555.30  335.40 (-4500)  605.30  385.40>
        , <&key_physical_attrs 100   150  456.30  551.20 (-3000)  531.30  601.20>
        , <&key_physical_attrs 100   150 1177.00  551.20   3000  1202.00  601.20>
        , <&key_physical_attrs 100   100 1078.00  335.40   4500  1128.00  385.40>
        , <&key_physical_attrs 100   100 1148.70  260.60   4500  1198.70  310.60>
        , <&key_physical_attrs 100   100 1263.10  120.60 (-3000) 1313.10  170.60>
        , <&key_physical_attrs 100   100 1443.60  108.10 (-2000) 1493.60  158.10>
        , <&key_physical_attrs 100   100 1597.60  145.30 (-1500) 1647.60  195.30>
        // Row 1
        , <&key_physical_attrs 100   100   11.20  241.90   1500    61.20  291.90>
        , <&key_physical_attrs 100   100  157.40  202.00   2000   207.40  252.00>
        , <&key_physical_attrs 100   100  323.00  207.20   3000   373.00  257.20>
        , <&key_physical_attrs 100   100  417.80  331.30 (-4500)  467.80  381.30>
        , <&key_physical_attrs 100   100  488.50  406.10 (-4500)  538.50  456.10>
        , <&key_physical_attrs 100   150  503.50  637.80 (-3000)  578.50  687.80>
        , <&key_physical_attrs 100   150 1129.80  637.80   3000  1154.80  687.80>
        , <&key_physical_attrs 100   100 1144.80  406.10   4500  1194.80  456.10>
        , <&key_physical_attrs 100   100 1215.50  331.30   4500  1265.50  381.30>
        , <&key_physical_attrs 100   100 1310.30  207.20 (-3000) 1360.30  257.20>

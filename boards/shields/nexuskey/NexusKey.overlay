#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen
    {
        zmk,kscan = &default_kscan;
        zmk,matrix-transform = &default_transform;
    };

    default_kscan: kscan
    {
        compatible = "zmk,kscan-gpio-matrix";
        label = "default_kscan";
        diode-direction = "col2row";

        row-gpios = <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,   //024
                    <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;   //106

        col-gpios = <&pro_micro 16 GPIO_ACTIVE_HIGH>,    //115
                    <&pro_micro 10 GPIO_ACTIVE_HIGH>;    //100
    };

    default_transform: matrix_transform
    {
        compatible = "zmk,matrix-transform";
        rows = <2>;
        columns = <2>;

        map =
        <
            RC(0,0) RC(0,1)
            RC(1,0) RC(1,1)
        >;
    };
};
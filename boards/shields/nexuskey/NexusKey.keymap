#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define NUM 1
#define NAV 2
#define GAME 3
#define BT 4

&soft_off {
    hold-time-ms = <3000>;  // Wait 3s
};

// Mod-Tap
&mt {
    tapping-term-ms = <1000>;
};

// NO PONER SPACE Y BACKSPACE EN EL MISMO LADO, PONERLO DE LADOS DIFERENTES PARA BALANCEAR DEDOS.
// PONER EL ESCAPE EN VEZ DE SEMICOLON

/ {
    keymap
    {
        compatible = "zmk,keymap";

        default_layer {
            bindings = 
            <
                &kp Q   &kp W       &kp F       &kp P           &kp B                                           &kp J           &kp L           &kp U       &kp Y       &kp ESC
                &kp A   &mt LGUI R  &mt RALT S   &mt LCTRL T   &mt LSHFT G   &lt NUM TAB    &lt NUM BSPC      &mt RSHFT M    &mt RCTRL N   &mt LALT E    &mt RGUI I  &kp O
                &kp Z   &kp X       &kp C       &kp D           &kp V       &lt NAV SPACE      &lt NAV ENTER      &kp K           &kp H           &kp COMMA   &kp PERIOD  &kp SLASH
            >;
        };

        num_layer {
            bindings = 
            <
                &kp N1      &kp N2              &kp N3           &kp N4                 &kp N5                                  &kp N6                  &kp N7                      &kp N8              &kp N9              &kp N0
                &kp DOLLAR  &mt LGUI PLUS      &mt LALT LPAR      &mt LCTRL RPAR        &mt LSHFT AT     &trans     &trans     &mt RSHFT BACKSLASH      &mt RCTRL UNDERSCORE      &mt  RALT EQUAL       &mt RGUI MINUS      &kp SEMICOLON
                &kp EXCL    &kp HASH           &kp LEFT_BRACE      &kp RIGHT_BRACE      &kp GRAVE        &trans     &trans     &kp AMPERSAND           &kp LEFT_BRACKET         &kp RIGHT_BRACKET      &kp PERCENT          &kp CARET
            >;
        };

        nav_layer {
            bindings = 
            <
                &kp F1      &kp F2              &kp F3           &kp F4                 &kp F5                                      &kp F6                  &kp F7                  &kp F8               &kp F9              &kp F10
                &kp F11     &mt LGUI HOME      &mt LALT PSCRN      &mt LCTRL DEL        &mt LSHFT PG_UP     &trans     &trans     &kp RSHFT                 &kp RCTRL               &mt RALT UP       &kp RGUI              &kp F12
                &none       &kp END             &kp ESC             &kp INS             &kp PG_DN        &trans     &trans          &none                   &kp LEFT                   &kp DOWN             &kp RIGHT       &none
            >;
        };

        game_layer {
            bindings = 
            <
                &kp ESC   &kp Q       &kp W       &kp E           &kp R                                           &kp T           &kp Y           &kp U       &kp I       &kp O
                &kp LSHFT   &kp A       &kp S       &kp D           &kp F       &trans          &lt NUM TAB     &kp G             &kp H           &kp J         &kp K       &kp L
                &kp LCTRL   &kp Z       &kp X       &kp C           &kp V       &kp SPACE      &trans           &kp B           &kp N           &kp M   &kp P  &kp LALT
            >;
        };

        bt_layer {
            bindings = 
            <
                &none       &none           &bootloader             &none               &sys_reset                              &sys_reset      &none         &bootloader         &none              &none
                &none       &none           &soft_off               &none               &none            &trans     &trans      &none           &none          &soft_off            &none            &none
                &bt BT_CLR_ALL  &bt BT_SEL 2    &bt BT_SEL 1            &bt BT_SEL 0         &none           &trans     &trans      &none           &bt BT_SEL 0    &bt BT_SEL 1        &bt BT_SEL 2     &bt BT_CLR_ALL
            >;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_game_layer {
            timeout-ms = <50>;
            key-positions = <15 16 27 28>;
            bindings = <&tog GAME>;
        };

        combo_bt_layer {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&mo BT>;
        };
    };
};
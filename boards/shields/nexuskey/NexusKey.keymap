#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap
    {
        compatible = "zmk,keymap";

        default_layer {
            bindings = 
            <
                &kp A    &kp BACKSPACE
                &kp C    &kp SPACE
            >;
        };

        bt_layer {
            bindings = 
            <
                &bt BT_SEL 0    &bootloader
                &bt BT_CLR    &bt BT_SEL 1
            >;
        };
    };
};
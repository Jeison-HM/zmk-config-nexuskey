#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk, keymap";

        default_layer {
            bindings = <
                &kp KP_A    &mo 1
                &kp KP_C    &kp KP_N3
            >;
        };

        bt_layer {
            bindings = <
                &bt BT_SEL 0    &bootloader
                &bt BT_CLR    &bt BT_SEL 1
            >;
        };
    };
};